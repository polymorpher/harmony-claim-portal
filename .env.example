# Copy to .env (gitignored) and fill in. Infra and deploy scripts parse
# KEY=VALUE only — they do not source this file as bash.

# --- GCP -------------------------------------------------------------------
# Dedicated project id (already created for this deployment).
GCP_PROJECT=harmony-migration
# Billing account to link when 00-create-project.sh has to create the project:
# `gcloud billing accounts list`. Leave empty when the project already exists.
BILLING_ACCOUNT=
# Optional parent for project creation (one of the two, or neither).
GCP_ORGANIZATION=
GCP_FOLDER=
GCP_REGION=us-west1
GCP_ZONE=us-west1-b

# --- VM (API server + PostgreSQL) -------------------------------------------
VM_NAME=claim-portal-vm
VM_MACHINE_TYPE=e2-medium
VM_DISK_GB=30
VM_IMAGE_FAMILY=debian-12
VM_IMAGE_PROJECT=debian-cloud
# VPC network for the VM. A tagged DENY rule (priority 1000) shadows the
# network's broad default-allow rules for this VM; only IAP SSH and the load
# balancer ranges are allowed (priority 900).
VM_NETWORK=default
VM_NETWORK_TAG=claim-api
API_PORT=8080
PG_MAJOR=18
NODE_MAJOR=22
# Oldest Node the VM may run, on NODE_MAJOR. deploy-backend.sh and
# backend/deploy/upgrade-node.sh upgrade the NodeSource package to meet it.
# Raise it with each Node security release.
NODE_MIN_VERSION=22.23.4

# --- Database ----------------------------------------------------------------
DB_NAME=claims
DB_USER=claimapi
# Local port used by backend/deploy/tunnel-db.sh for the IAP SSH tunnel.
DB_TUNNEL_PORT=5433

# --- Frontend bucket + load balancer ------------------------------------------
# Globally unique GCS bucket name that holds the built frontend.
FRONTEND_BUCKET=migrate-country-frontend
FRONTEND_BUCKET_LOCATION=US
DOMAIN=migrate.country
# Space-separated additional hostnames covered by the certificate and DNS.
EXTRA_DOMAINS=www.migrate.country
# Prefix for load balancer resources (IP, backends, URL maps, proxies, cert).
LB_NAME=claim-portal

# --- Cloudflare ---------------------------------------------------------------
# API token with Zone.DNS:Edit, Zone.Zone Settings:Edit, Zone.Zone:Read on the zone.
CF_API_TOKEN=
CF_ZONE_NAME=migrate.country
# Optional edge rate limit (setup-dns.sh --rate-limit): requests per period per IP on /api/*.
CF_RATE_LIMIT_REQUESTS=60
CF_RATE_LIMIT_PERIOD=60

# --- Frontend build ----------------------------------------------------------------
# WalletConnect (Reown) project id. Without it the WalletConnect button is hidden,
# so phone wallets and Ledger Wallet (formerly Ledger Live) cannot connect.
# Browser wallets and Ledger over USB work without it. In the Reown dashboard,
# allow DOMAIN, EXTRA_DOMAINS, and http://localhost:5173 for development.
VITE_WALLETCONNECT_PROJECT_ID=
# Ethereum JSON-RPC endpoints the /vault and lookup pages read with, comma-separated and
# tried in order. They ship in the public bundle, so a keyed endpoint must be
# restricted to DOMAIN on the provider's side. Empty: Tenderly's public gateway,
# then dRPC and publicnode (both cap eth_getLogs ranges; the page splits ranges).
# /bridge reads its Ethereum claim contract with these too.
VITE_ETH_RPC_URLS=
# JSON-RPC endpoints /bridge reads and, for a Ledger over USB, sends claims
# with on the other four claim chains; comma-separated, tried in order, public
# like VITE_ETH_RPC_URLS. Empty: each chain's public endpoint, then publicnode
# and dRPC.
VITE_BSC_RPC_URLS=
VITE_ARBITRUM_RPC_URLS=
VITE_BASE_RPC_URLS=
VITE_LINEA_RPC_URLS=
# Development only: where /bridge loads proof files instead of the published
# run, e.g. a local server for injector/out/bridge-proofs/<run>/proofs.
# deploy-frontend.sh refuses to build with it set.
VITE_BRIDGE_PROOFS_URL=

# --- Bridge claims -----------------------------------------------------------
# Public bucket holding each bridge claim run's lists, trees, and (from
# frontend/deploy/publish-bridge-proofs.sh) the /bridge proof files.
BRIDGE_CLAIMS_BUCKET=harmony-bridge-claims
# Ethereum JSON-RPC for governor vault name changes, used by the confirmation
# process to read governor() and the vault bytecode. Comma-separated https
# URLs. Empty: those endpoints answer 503. A keyed URL stays in the confirm
# env on the VM; do not commit it.
VAULT_ETH_RPC_URLS=

# --- Backend runtime (defaults written to /etc/harmony-claim-api.env by bootstrap) ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW="1 minute"
EXPOSE_CONTRACT_AMOUNTS=false

# --- Next-batch confirmation ---------------------------------------------------
# Database passwords are generated on the VM by db/ops/setup-roles.sh and stored
# in root-only files there. Do not put database URLs or passwords in this file.
# Versions below are operator inputs for db/ops/load-candidates.sh. They are not secrets.
CONFIRM_DATA_VERSION=
CONFIRM_POLICY_VERSION=
CONFIRM_CUTOFF_TIME=2026-09-10T14:00:00Z
# Optional private bucket for db/ops/backup-confirm.sh. Leave empty to keep the dump local.
CONFIRM_BACKUP_BUCKET=
# Local only, after db/ops/setup-roles.sh --local. Not used on the VM.
# CONFIRM_OWNER_URL=postgres://claimapi@127.0.0.1:5434/claims
# Paid Ethereum archive RPC for db/ops/confirmed-wallets.sh --chain. Empty: RPC_URL from
# $HARMONY_MIGRATION_REPO/airdrop/.env. Keyed; keep it out of commits.
# ETH_RPC_URL=
