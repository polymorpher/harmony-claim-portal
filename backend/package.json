{
  "name": "@hcp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rate-limited single-address claim lookup API (Fastify)",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@hcp/shared": "workspace:*",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
