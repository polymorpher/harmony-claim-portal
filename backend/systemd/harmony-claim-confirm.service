[Unit]
Description=Harmony claim portal confirmation API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=claimconfirm
Group=claimconfirm
WorkingDirectory=/opt/harmony-claim-api/current
EnvironmentFile=/etc/harmony-claim-confirm.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/harmony-claim-api/current/dist/confirm-server.js
Restart=always
RestartSec=3
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/harmony-claim-api
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
